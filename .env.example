# Vidarbha Mandi AI — Environment Variables
#
# Copy this file to .env and fill in the values.
# The frontend (.env) and backend (backend/.env) can share the same
# root .env — Vite only reads VITE_ prefixed vars, and the backend
# reads all vars via dotenv.

# ──────────────────────────────────────────────
# Frontend (Vite — used by the React app)
# ──────────────────────────────────────────────
# Pre-populated by the Bolt environment. Do NOT change unless needed.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the Node/Express backend API.
# For local development: http://localhost:5000
# If not set, backend-dependent features (like ML prediction trigger)
# will show a "not configured" message instead of failing silently.
VITE_API_BASE_URL=http://localhost:5000

# ──────────────────────────────────────────────
# Backend (Node / Express)
# ──────────────────────────────────────────────
PORT=5000

# Supabase service-role key (server-side only — NEVER expose to frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CORS: comma-separated list of allowed origins, or leave empty to allow all
CORS_ORIGINS=

# URL of the Python ML prediction service
ML_SERVICE_URL=http://localhost:8000

# ──────────────────────────────────────────────
# External data sources
# ──────────────────────────────────────────────

# Government mandi price data (AGMARKNET / data.gov.in)
# Request a FREE API key at: https://data.gov.in
#   1. Create an account at https://data.gov.in
#   2. Go to "My Account" → "Generate API Key"
#   3. Paste the key below
# Until this key is set, the app shows "Mandi data unavailable"
# instead of displaying fake prices.
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Weather: uses Open-Meteo (free, no API key needed)
# No weather-related environment variables are required.

# ──────────────────────────────────────────────
# ML Service (Python — ml-service/)
# ──────────────────────────────────────────────
ML_PORT=8000

# Supabase credentials for the ML service to fetch historical data
# (same values as above — the ML service reads them directly)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are read from env.
